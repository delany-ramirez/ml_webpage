---
/**
 * Búsqueda del curso (Ctrl+K / botón en la nav). Usa el índice estático de Pagefind
 * (generado en postbuild) y lo carga solo al abrir por primera vez. Resultados agrupados por
 * módulo; navegación con ↑ ↓ Enter, cierre con Esc.
 */
---

<div class="buscador" id="buscador" hidden role="dialog" aria-modal="true" aria-label="Buscar en el curso">
  <div class="bq-fondo" data-buscador-cerrar></div>
  <div class="bq-caja">
    <div class="bq-entrada">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" id="bq-input" placeholder="Buscar en el curso…" autocomplete="off" spellcheck="false" aria-label="Texto a buscar" aria-controls="bq-resultados" />
      <kbd>Esc</kbd>
    </div>
    <div class="bq-resultados" id="bq-resultados" role="listbox" aria-label="Resultados"></div>
    <div class="bq-pie">
      <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
      <span><kbd>↵</kbd> abrir</span>
      <span class="bq-estado" id="bq-estado" aria-live="polite"></span>
    </div>
  </div>
</div>

<script>
  type Pagefind = { init: () => Promise<void>; search: (q: string) => Promise<{ results: { data: () => Promise<Resultado> }[] }> };
  type Resultado = { url: string; excerpt: string; meta: Record<string, string> };

  const dialogo = document.getElementById("buscador")!;
  const input = document.getElementById("bq-input") as HTMLInputElement;
  const lista = document.getElementById("bq-resultados")!;
  const estado = document.getElementById("bq-estado")!;
  let pagefind: Pagefind | null = null;
  let cargando: Promise<Pagefind | null> | null = null;
  let previo: HTMLElement | null = null;
  let seleccion = -1;
  let ultimaBusqueda = 0;

  async function cargar(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    if (!cargando) {
      // Ruta en variable para que Vite/Rollup no intente resolverla en build (la genera Pagefind en postbuild).
      const url = "/pagefind/pagefind.js";
      cargando = import(/* @vite-ignore */ url)
        .then(async (m) => { await m.init(); pagefind = m as Pagefind; return pagefind; })
        .catch(() => { estado.textContent = "El índice de búsqueda solo existe en el sitio publicado (npm run build)."; return null; });
    }
    return cargando;
  }

  function abrir() {
    previo = document.activeElement as HTMLElement;
    dialogo.hidden = false;
    document.body.style.overflow = "hidden";
    input.value = "";
    lista.innerHTML = "";
    estado.textContent = "";
    seleccion = -1;
    input.focus();
    cargar();
  }
  function cerrar() {
    dialogo.hidden = true;
    document.body.style.overflow = "";
    previo?.focus();
  }

  function pintar(resultados: Resultado[]) {
    lista.innerHTML = "";
    seleccion = -1;
    if (resultados.length === 0) {
      lista.innerHTML = `<p class="bq-vacio">Sin resultados.</p>`;
      return;
    }
    const grupos = new Map<string, Resultado[]>();
    for (const r of resultados) {
      const k = r.meta.modulo ? `Módulo ${r.meta.modulo}` : "Curso";
      if (!grupos.has(k)) grupos.set(k, []);
      grupos.get(k)!.push(r);
    }
    for (const [nombre, rs] of grupos) {
      const h = document.createElement("div");
      h.className = "bq-grupo";
      h.textContent = nombre;
      lista.appendChild(h);
      for (const r of rs) {
        const a = document.createElement("a");
        a.className = "bq-item";
        a.href = r.url;
        a.setAttribute("role", "option");
        a.innerHTML = `<span class="bq-titulo">${r.meta.title ?? r.url}</span>${r.meta.tipo ? `<span class="bq-tipo">${r.meta.tipo}</span>` : ""}<span class="bq-excerpt">${r.excerpt}</span>`;
        lista.appendChild(a);
      }
    }
  }

  async function buscar(q: string) {
    const id = ++ultimaBusqueda;
    const pf = await cargar();
    if (!pf || id !== ultimaBusqueda) return;
    if (q.trim().length < 2) { lista.innerHTML = ""; estado.textContent = ""; return; }
    const res = await pf.search(q);
    if (id !== ultimaBusqueda) return;
    const datos = await Promise.all(res.results.slice(0, 12).map((r) => r.data()));
    estado.textContent = `${res.results.length} resultado${res.results.length === 1 ? "" : "s"}`;
    pintar(datos);
  }

  function mover(delta: number) {
    const items = [...lista.querySelectorAll<HTMLElement>(".bq-item")];
    if (items.length === 0) return;
    seleccion = (seleccion + delta + items.length) % items.length;
    items.forEach((it, i) => it.classList.toggle("activo", i === seleccion));
    items[seleccion].scrollIntoView({ block: "nearest" });
  }

  let temporizador: number | undefined;
  input.addEventListener("input", () => {
    window.clearTimeout(temporizador);
    temporizador = window.setTimeout(() => buscar(input.value), 120);
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); mover(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); mover(-1); }
    else if (e.key === "Enter") {
      const it = lista.querySelectorAll<HTMLAnchorElement>(".bq-item")[seleccion] ?? lista.querySelector<HTMLAnchorElement>(".bq-item");
      if (it) location.href = it.href;
    }
  });
  document.querySelectorAll("[data-buscador-abrir]").forEach((b) => b.addEventListener("click", abrir));
  document.querySelectorAll("[data-buscador-cerrar]").forEach((b) => b.addEventListener("click", cerrar));
  window.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); dialogo.hidden ? abrir() : cerrar(); }
    else if (e.key === "Escape" && !dialogo.hidden) cerrar();
  });
</script>

<style>
  .buscador {
    position: fixed;
    inset: 0;
    z-index: 100;
  }
  .bq-fondo {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
  }
  .bq-caja {
    position: relative;
    width: min(640px, calc(100vw - 32px));
    margin: 10vh auto 0;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .bq-entrada {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .bq-entrada svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .bq-entrada input {
    flex: 1;
    font: inherit;
    font-size: 16px;
    color: var(--text);
    background: none;
    border: 0;
    outline: none;
    min-width: 0;
  }
  .bq-entrada input::-webkit-search-cancel-button {
    display: none;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    padding: 2px 6px;
  }
  .bq-resultados {
    max-height: min(60vh, 520px);
    overflow-y: auto;
    padding: 6px;
  }
  .bq-resultados :global(.bq-grupo) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 10px 12px 4px;
  }
  .bq-resultados :global(.bq-item) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 10px;
    padding: 9px 12px;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .bq-resultados :global(.bq-item:hover),
  .bq-resultados :global(.bq-item.activo) {
    background: var(--gold-soft);
  }
  .bq-resultados :global(.bq-titulo) {
    font-weight: 500;
    font-size: 14.5px;
  }
  .bq-resultados :global(.bq-tipo) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-2);
    align-self: center;
  }
  .bq-resultados :global(.bq-excerpt) {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.45;
  }
  .bq-resultados :global(.bq-excerpt mark) {
    background: var(--gold-soft);
    color: var(--gold);
    border-radius: 3px;
    padding: 0 2px;
  }
  .bq-resultados :global(.bq-vacio) {
    padding: 22px 12px;
    text-align: center;
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .bq-pie {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 8px 16px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-2);
  }
  .bq-pie span {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .bq-estado {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .bq-caja {
      margin-top: 4vh;
    }
    .bq-pie span:not(.bq-estado) {
      display: none;
    }
  }
</style>
