---
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" title="Inicio del curso">
      <span class="mk"></span>
      <span class="nombre">Délany Ramírez del Río</span>
      <span class="sep">/</span>
      <span class="curso">Machine Learning</span>
    </a>
    <nav class="nav-links" aria-label="Principal">
      <a href="/programa/">Programa</a>
      <a href="/instalacion/">Instalación</a>
      <a href="https://delanyr.dev" rel="noopener">delanyr.dev ↗</a>
      <button type="button" class="buscar keep" data-buscador-abrir aria-label="Buscar en el curso (Ctrl+K)" title="Buscar (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <span class="buscar-txt">Buscar</span>
        <kbd class="buscar-kbd">Ctrl K</kbd>
      </button>
      <button
        class="icon-btn keep"
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema claro/oscuro"
        title="Cambiar tema"
      >
        <!-- sol (se ve en tema oscuro) -->
        <svg class="ico-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <!-- luna (se ve en tema claro) -->
        <svg class="ico-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .ico-luna { display: none; }
  :global(:root[data-theme="light"]) .ico-sol { display: none; }
  :global(:root[data-theme="light"]) .ico-luna { display: block; }
  .nav-links .icon-btn { margin-left: 4px; }
  .buscar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 10px 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    color: var(--muted);
    font-size: 13px;
    transition: color 0.2s, border-color 0.2s;
  }
  .buscar:hover { color: var(--gold); border-color: var(--gold); }
  .buscar svg { width: 16px; height: 16px; }
  .buscar-kbd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1px 5px;
  }
  @media (max-width: 760px) {
    .buscar { padding: 0; width: 36px; justify-content: center; }
    .buscar-txt, .buscar-kbd { display: none; }
  }
</style>
