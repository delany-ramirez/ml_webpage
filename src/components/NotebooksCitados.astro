---
/**
 * Fila compacta de notebooks con botones Colab / GitHub. Se usa en la página del ejercicio y
 * bajo cada ejercicio del bloque Practica, con los notebooks que el enunciado cita.
 */
import type { Notebook } from "../lib/notebooks-fs";
import { tituloHtml, nn } from "../lib/curso";

interface Props {
  notebooks: Notebook[];
  etiqueta?: string;
}
const { notebooks, etiqueta = "Notebooks de apoyo" } = Astro.props;
---

{notebooks.length > 0 && (
  <div class="nbc" data-pagefind-ignore>
    <span class="nbc-et">{etiqueta}</span>
    <ul>
      {notebooks.map((nb) => (
        <li>
          <span class="nbc-n">{nn(nb.orden)}</span>
          <span class="nbc-t" set:html={tituloHtml(nb.titulo)} />
          <a class="btn btn-primary btn-xs" href={nb.colab} target="_blank" rel="noopener">Colab ↗</a>
          <a class="btn btn-ghost btn-xs" href={nb.github} target="_blank" rel="noopener">GitHub</a>
        </li>
      ))}
    </ul>
    <span class="nbc-pie">En Colab, ejecuta la primera celda antes que nada: carga los datos del curso.</span>
  </div>
)}

<style>
  .nbc {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nbc-et {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .nbc ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nbc li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: 14px;
  }
  .nbc-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold);
  }
  .nbc-t {
    flex: 1 1 200px;
  }
  .nbc-t :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .nbc-pie {
    font-size: 12px;
    color: var(--muted-2);
  }
  .btn-xs {
    padding: 5px 10px;
    font-size: 11.5px;
  }
</style>
