---
import type { Leccion } from "../lib/curso";
import { tituloHtml } from "../lib/curso";

interface Props {
  prev: Leccion | null;
  next: Leccion | null;
  etiquetas?: [string, string];
}
const { prev, next, etiquetas = ["← Anterior", "Siguiente →"] } = Astro.props;
---

{(prev || next) && (
  <nav class="prevnext rise d2" aria-label="Navegación entre lecciones">
    {prev ? (
      <a href={prev.ruta} class="pn">
        <span class="lbl">{etiquetas[0]}</span>
        <span class="ttl" set:html={tituloHtml(prev.titulo)} />
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={next.ruta} class="pn der">
        <span class="lbl">{etiquetas[1]}</span>
        <span class="ttl" set:html={tituloHtml(next.titulo)} />
      </a>
    ) : (
      <span />
    )}
  </nav>
)}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    max-width: 72ch;
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    transition: border-color 0.2s, background 0.2s;
  }
  .pn:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .pn.der {
    text-align: right;
  }
  .pn .lbl {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .pn .ttl {
    font-size: 14.5px;
    color: var(--text);
    font-weight: 500;
  }
  .pn .ttl :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--gold);
  }
  @media (max-width: 560px) {
    .prevnext {
      grid-template-columns: 1fr;
    }
    .pn.der {
      text-align: left;
    }
  }
</style>
