---
/**
 * Autoevaluación de opción múltiple: una pregunta a la vez, feedback inmediato con
 * explicación, puntaje final y reintento. Guarda el mejor puntaje en el progreso con la
 * `clave` dada (p. ej. "autoevaluacion/3" o "autoevaluacion/3/02-descenso-gradiente").
 */
import type { Pregunta } from "../lib/interactivos";

interface Props {
  clave: string;
  preguntas: Pregunta[];
  titulo?: string;
}
const { clave, preguntas, titulo = "Autoevaluación" } = Astro.props;
const datos = preguntas.map((p) => ({ pregunta: p.pregunta, opciones: p.opciones, correcta: p.correcta, explicacion: p.explicacion }));
---

<div class="quiz" data-quiz={clave}>
  <script type="application/json" data-quiz-datos set:html={JSON.stringify(datos)} />
  <div class="q-head">
    <span class="q-titulo">{titulo}</span>
    <span class="q-contador" data-q-contador>1 / {preguntas.length}</span>
  </div>
  <div class="q-cuerpo" data-q-cuerpo>
    <p class="q-pregunta" data-q-pregunta></p>
    <div class="q-opciones" data-q-opciones role="group" aria-label="Opciones"></div>
    <div class="q-feedback" data-q-feedback hidden></div>
  </div>
  <div class="q-final" data-q-final hidden>
    <span class="eyebrow">Resultado</span>
    <p class="q-puntaje"><span data-q-score>0</span> / {preguntas.length}</p>
    <p class="q-mensaje" data-q-mensaje></p>
    <p class="q-mejor" data-q-mejor hidden>Tu mejor puntaje guardado: <span data-q-mejor-valor></span></p>
  </div>
  <div class="q-pie">
    <span class="q-progreso" aria-hidden="true"><span class="fill" data-q-barra></span></span>
    <button type="button" class="btn btn-ghost btn-sm" data-q-siguiente hidden>Siguiente →</button>
    <button type="button" class="btn btn-primary btn-sm" data-q-reintentar hidden>Reintentar</button>
  </div>
</div>

<script>
  import { guardarQuiz, leer } from "../scripts/progress";

  interface Dato { pregunta: string; opciones: string[]; correcta: number; explicacion: string }
  const LETRAS = "ABCDEF";

  function iniciar(root: HTMLElement) {
    const clave = root.dataset.quiz!;
    const datos = JSON.parse(root.querySelector("[data-quiz-datos]")!.textContent || "[]") as Dato[];
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const contador = $("[data-q-contador]"), cuerpo = $("[data-q-cuerpo]"), pregunta = $("[data-q-pregunta]");
    const opciones = $("[data-q-opciones]"), feedback = $("[data-q-feedback]"), final = $("[data-q-final]");
    const score = $("[data-q-score]"), mensaje = $("[data-q-mensaje]"), mejor = $("[data-q-mejor]"), mejorValor = $("[data-q-mejor-valor]");
    const barra = $("[data-q-barra]"), btnSig = $<HTMLButtonElement>("[data-q-siguiente]"), btnRe = $<HTMLButtonElement>("[data-q-reintentar]");

    let i = 0, aciertos = 0, respondida = false;

    const pintar = () => {
      const d = datos[i];
      respondida = false;
      contador.textContent = `${i + 1} / ${datos.length}`;
      barra.style.width = `${(100 * i) / datos.length}%`;
      pregunta.textContent = d.pregunta;
      feedback.hidden = true;
      feedback.className = "q-feedback";
      btnSig.hidden = true;
      opciones.innerHTML = "";
      d.opciones.forEach((texto, k) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "q-opcion";
        b.innerHTML = `<span class="q-letra">${LETRAS[k]}</span><span>${texto}</span>`;
        b.addEventListener("click", () => responder(k));
        opciones.appendChild(b);
      });
    };

    const responder = (k: number) => {
      if (respondida) return;
      respondida = true;
      const d = datos[i];
      const correcta = k === d.correcta;
      if (correcta) aciertos++;
      opciones.querySelectorAll<HTMLButtonElement>(".q-opcion").forEach((b, j) => {
        b.disabled = true;
        if (j === d.correcta) b.classList.add("correcta");
        else if (j === k) b.classList.add("incorrecta");
      });
      feedback.innerHTML = `<strong>${correcta ? "Correcto." : "No es esa."}</strong> ${d.explicacion}`;
      feedback.classList.add(correcta ? "ok" : "err");
      feedback.hidden = false;
      btnSig.hidden = false;
      btnSig.textContent = i === datos.length - 1 ? "Ver resultado →" : "Siguiente →";
      btnSig.focus();
    };

    const terminar = () => {
      cuerpo.hidden = true;
      final.hidden = false;
      btnSig.hidden = true;
      btnRe.hidden = false;
      barra.style.width = "100%";
      score.textContent = String(aciertos);
      const p = aciertos / datos.length;
      mensaje.textContent =
        p === 1 ? "Impecable. Este módulo lo tienes claro." :
        p >= 0.8 ? "Muy bien. Revisa las explicaciones de las que fallaste." :
        p >= 0.5 ? "Vas por buen camino; vuelve a la teoría de las preguntas falladas." :
        "Conviene releer el módulo antes del quiz de cierre.";
      const previo = leer().autoevaluacion[clave];
      guardarQuiz(clave, aciertos, datos.length);
      if (previo && previo.score > aciertos) {
        mejor.hidden = false;
        mejorValor.textContent = `${previo.score} / ${previo.total}`;
      } else {
        mejor.hidden = true;
      }
    };

    btnSig.addEventListener("click", () => {
      if (i < datos.length - 1) { i++; pintar(); } else terminar();
    });
    btnRe.addEventListener("click", () => {
      i = 0; aciertos = 0;
      final.hidden = true; cuerpo.hidden = false; btnRe.hidden = true;
      pintar();
    });

    pintar();
  }

  document.querySelectorAll<HTMLElement>("[data-quiz]").forEach(iniciar);
</script>

<style>
  .quiz {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 20px 22px;
    max-width: 72ch;
  }
  .q-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    margin-bottom: 16px;
  }
  .q-titulo {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .q-contador {
    color: var(--muted-2);
  }
  .q-pregunta {
    font-size: 16.5px;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .q-opciones {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .quiz :global(.q-opcion) {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    align-items: start;
    text-align: left;
    padding: 11px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font-size: 14.5px;
    line-height: 1.5;
    transition: border-color 0.2s, background 0.2s;
  }
  .quiz :global(.q-opcion:not(:disabled):hover) {
    border-color: var(--gold);
    background: var(--gold-soft);
  }
  .quiz :global(.q-opcion:disabled) {
    cursor: default;
    color: var(--muted);
  }
  .quiz :global(.q-letra) {
    font-family: var(--font-mono);
    font-size: 12px;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }
  .quiz :global(.q-opcion.correcta) {
    border-color: var(--ok);
    background: var(--ok-soft);
    color: var(--text);
  }
  .quiz :global(.q-opcion.correcta .q-letra) {
    background: var(--ok);
    border-color: var(--ok);
    color: var(--ink);
  }
  .quiz :global(.q-opcion.incorrecta) {
    border-color: var(--err);
    background: var(--err-soft);
    color: var(--text);
  }
  .quiz :global(.q-opcion.incorrecta .q-letra) {
    background: var(--err);
    border-color: var(--err);
    color: #fff;
  }
  .q-feedback {
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 14.5px;
    line-height: 1.55;
    border: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .q-feedback strong {
    color: var(--text);
  }
  .q-feedback.ok {
    border-color: var(--ok);
    background: var(--ok-soft);
  }
  .q-feedback.err {
    border-color: var(--err);
    background: var(--err-soft);
  }
  .q-final {
    text-align: center;
    padding: 12px 0 6px;
  }
  .q-puntaje {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 600;
    color: var(--gold);
    margin: 8px 0 6px;
    letter-spacing: -0.02em;
  }
  .q-mensaje {
    color: var(--muted);
    font-size: 15px;
  }
  .q-mejor {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-2);
    margin-top: 8px;
  }
  .q-pie {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .q-progreso {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .q-progreso .fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gold);
    transition: width 0.3s;
  }
</style>
