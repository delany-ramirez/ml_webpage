---
// Índice provisional (Fase 0): lista plana de lecciones para navegar.
// La landing definitiva llega en la Fase 1.
import Base from "../layouts/Base.astro";
import { MODULOS, leccionesPorModulo, tituloHtml, etiquetaSesion, nn } from "../lib/curso";

const porModulo = await leccionesPorModulo();
---

<Base>
  <main class="wrap">
    <section class="hero rise">
      <span class="eyebrow">Maestría en Ingeniería de Sistemas y Computación · UTP</span>
      <h1>Machine <span class="g">Learning</span></h1>
      <p class="lede">
        48 horas, 14 sesiones, 6 módulos. Teoría con las matemáticas necesarias, notebooks
        ejecutables y un proyecto integrador que termina desplegado como API.
      </p>
    </section>

    <section class="modulos rise d1">
      {MODULOS.map((m) => {
        const lecciones = porModulo.get(m.numero) ?? [];
        return (
          <div class="modulo">
            <div class="mod-head">
              <span class="chip gold">Módulo {m.numero}</span>
              <h2>{m.nombre}</h2>
              <span class="note">
                Sesiones {m.sesiones[0]}{m.sesiones[1] !== m.sesiones[0] ? `–${m.sesiones[1]}` : ""} · {m.horas} h
              </span>
            </div>
            {lecciones.length === 0 ? (
              <p class="vacio">En construcción.</p>
            ) : (
              <ol class="lista">
                {lecciones.map((l) => (
                  <li>
                    <a href={l.ruta}>
                      <span class="n">{nn(l.orden)}</span>
                      <span class="t" set:html={tituloHtml(l.titulo)} />
                      <span class="s">{etiquetaSesion(l)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        );
      })}
    </section>
  </main>
</Base>

<style>
  .hero {
    padding: 72px 0 48px;
  }
  .hero h1 {
    font-size: clamp(40px, 6vw, 68px);
    margin: 18px 0 20px;
  }
  .hero h1 .g {
    color: var(--gold);
  }
  .hero .lede {
    font-size: 18px;
    color: var(--muted);
    max-width: 52ch;
  }
  .modulos {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: 40px;
  }
  .modulo {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 26px;
  }
  .mod-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .mod-head h2 {
    font-size: 20px;
  }
  .vacio {
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .lista {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .lista a {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 10px 8px;
    border-radius: 8px;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s;
  }
  .lista li:last-child a {
    border-bottom: 0;
  }
  .lista a:hover {
    background: var(--surface-2);
  }
  .lista .n {
    font-family: var(--font-mono);
    color: var(--gold);
    font-size: 13px;
  }
  .lista .t {
    font-size: 15px;
  }
  .lista .t :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--gold);
  }
  .lista .s {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-2);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .lista a {
      grid-template-columns: 30px 1fr;
    }
    .lista .s {
      display: none;
    }
  }
</style>
