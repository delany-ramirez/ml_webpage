---
import { getCollection, render } from "astro:content";
import Curso from "../../../layouts/Curso.astro";
import Cabecera from "../../../components/Cabecera.astro";
import { parseLeccion, tituloTexto, etiquetaSesion } from "../../../lib/curso";
import { modulosConAutoevaluacion } from "../../../lib/interactivos";

export async function getStaticPaths() {
  const entradas = await getCollection("quizzes");
  return entradas.flatMap((entry) => {
    const leccion = parseLeccion(entry, "quizzes");
    if (!leccion) return [];
    return [{ params: { n: String(leccion.modulo.numero) }, props: { entry, leccion } }];
  });
}

const { entry, leccion } = Astro.props;
const { Content, headings } = await render(entry);
const tieneAuto = (await modulosConAutoevaluacion()).has(leccion.modulo.numero);
---

<Curso title={`Quiz · Módulo ${leccion.modulo.numero}`} activo={leccion.id} moduloActivo={leccion.modulo.numero} headings={headings} tipo="Quiz">
  <Cabecera
    eyebrow={`Módulo ${leccion.modulo.numero} · ${etiquetaSesion(leccion)} · Quiz de cierre`}
    titulo={leccion.titulo}
    headings={headings}
  >
    <span class="chip gold">{leccion.modulo.corto}</span>
    {leccion.preguntas && <span class="chip">{leccion.preguntas} preguntas</span>}
    {leccion.duracion && <span class="chip">⏱ {leccion.duracion}</span>}
  </Cabecera>

  <aside class="aviso rise" data-pagefind-ignore>
    <strong>Cómo se responde.</strong> Este quiz es de respuesta abierta y se entrega al
    docente; se evalúa el razonamiento, no la extensión. La clave de respuestas es material del
    docente y no se publica aquí. Para comprobar tu comprensión por tu cuenta,
    {tieneAuto ? (
      <>usa la <a href={`/modulo/${leccion.modulo.numero}/autoevaluacion/`}>autoevaluación interactiva</a> del módulo.</>
    ) : (
      <>cada módulo tendrá una <em>autoevaluación</em> interactiva de opción múltiple.</>
    )}
  </aside>

  <article class="prose rise d1">
    <Content />
  </article>
</Curso>

<style>
  .aviso {
    margin-bottom: 32px;
    max-width: 72ch;
    font-size: 14.5px;
    color: var(--muted);
    border: 1px solid var(--gold);
    background: var(--gold-soft);
    border-radius: 10px;
    padding: 14px 18px;
  }
  .aviso strong {
    color: var(--text);
  }
  .aviso a {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
