---
import Curso from "../layouts/Curso.astro";
import Cabecera from "../components/Cabecera.astro";
import IndiceCurso from "../components/IndiceCurso.astro";
import { MODULOS, leccionesPorModulo, tituloHtml, tituloTexto, claveProgreso, nn } from "../lib/curso";

const porModulo = await leccionesPorModulo();
const nombres: Record<string, string> = {};
for (const ls of porModulo.values()) for (const l of ls) nombres[claveProgreso(l)] = tituloTexto(l.titulo);
---

<Curso title="Tu progreso" description="Progreso del curso guardado en este navegador; expórtalo para continuar en otro dispositivo." tipo="Progreso">
  <IndiceCurso />
  <script is:inline type="application/json" id="nombres-lecciones" set:html={JSON.stringify(nombres)} />
  <Cabecera eyebrow="Curso" titulo="Tu progreso">
    <span class="chip gold" data-progreso-texto>0 / 0 · 0%</span>
  </Cabecera>

  <section class="tarjeta rise">
    <div class="barra-global" aria-hidden="true"><span class="fill" data-progreso-global></span></div>
    <p class="nota">
      El progreso se guarda <strong>solo en este navegador</strong> (no hay cuentas ni servidor).
      Para continuar en otro dispositivo, copia tu código aquí y pégalo allá.
    </p>
  </section>

  <section class="modulos rise d1">
    {MODULOS.map((m) => {
      const ls = porModulo.get(m.numero) ?? [];
      if (ls.length === 0) return null;
      return (
        <details class="mod" open={m.numero === 1 || undefined}>
          <summary>
            <span class="idx">M{m.numero}</span>
            <span class="nombre">{m.nombre}</span>
            <span class="cuenta" data-cuenta-modulo={m.numero}>0/{ls.length}</span>
            <span class="mini"><span class="fill" data-progreso-modulo={m.numero}></span></span>
          </summary>
          <ol>
            {ls.map((l) => (
              <li>
                <button type="button" class="fila" data-completar={claveProgreso(l)} aria-pressed="false">
                  <span class="marca" data-marca={claveProgreso(l)} aria-hidden="true"></span>
                  <span class="n">{nn(l.orden)}</span>
                  <span class="t" set:html={tituloHtml(l.titulo)} />
                </button>
                <a href={l.ruta} class="ir" aria-label="Abrir lección">→</a>
              </li>
            ))}
          </ol>
        </details>
      );
    })}
  </section>

  <section class="tarjeta rise d2" id="autoevaluaciones" hidden>
    <span class="eyebrow">Autoevaluaciones</span>
    <ul class="auto-lista" id="auto-lista"></ul>
  </section>

  <section class="tarjeta rise d2" id="exportar">
    <span class="eyebrow">Llevar el progreso a otro dispositivo</span>
    <div class="dos">
      <div>
        <h2>Exportar</h2>
        <p>Copia este código y guárdalo (o envíatelo). Contiene solo tus lecciones completadas y resultados de autoevaluación.</p>
        <textarea id="codigo-exportar" class="codigo" readonly rows="3" aria-label="Código de progreso"></textarea>
        <div class="acciones">
          <button type="button" class="btn btn-primary btn-sm" id="btn-copiar">Copiar código</button>
          <span class="estado" id="estado-copiar" aria-live="polite"></span>
        </div>
      </div>
      <div>
        <h2>Restaurar</h2>
        <p>Pega un código exportado en otro navegador. Se <em>fusiona</em> con lo que ya tengas aquí; nada se pierde.</p>
        <textarea id="codigo-importar" class="codigo" rows="3" placeholder="MLDR1-…" aria-label="Código a restaurar"></textarea>
        <div class="acciones">
          <button type="button" class="btn btn-ghost btn-sm" id="btn-importar">Restaurar</button>
          <span class="estado" id="estado-importar" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="tarjeta peligro rise d3">
    <div>
      <h2>Reiniciar</h2>
      <p>Borra todo el progreso guardado en este navegador. No se puede deshacer (salvo que tengas un código exportado).</p>
    </div>
    <button type="button" class="btn btn-ghost btn-sm" id="btn-reiniciar">Reiniciar progreso</button>
  </section>

  <script>
    import { exportar, importar, reiniciar, leer, type Progreso } from "../scripts/progress";

    // --- resultados de autoevaluación ---
    const nombresLecciones = JSON.parse(document.getElementById("nombres-lecciones")!.textContent || "{}") as Record<string, string>;
    const secAuto = document.getElementById("autoevaluaciones")!;
    const lista = document.getElementById("auto-lista")!;
    const etiqueta = (clave: string) => {
      // "autoevaluacion/3" → Módulo 3 · completa ; "autoevaluacion/3/02-x" → Módulo 3 · <título>
      const partes = clave.replace(/^autoevaluacion\//, "").split("/");
      const mod = `Módulo ${partes[0]}`;
      if (partes.length === 1) return `${mod} · autoevaluación completa`;
      return `${mod} · ${nombresLecciones[partes.join("/")] ?? partes[1]}`;
    };
    const pintarAuto = (p: Progreso) => {
      const entradas = Object.entries(p.autoevaluacion).sort(([a], [b]) => a.localeCompare(b));
      secAuto.hidden = entradas.length === 0;
      lista.innerHTML = entradas
        .map(([k, r]) => {
          const pct = Math.round((100 * r.score) / r.total);
          const fecha = new Date(r.fecha).toLocaleDateString("es-CO", { year: "numeric", month: "short", day: "numeric" });
          return `<li><span class="al-nombre">${etiqueta(k)}</span><span class="al-score">${r.score} / ${r.total} · ${pct}%</span><span class="al-fecha">${fecha}</span></li>`;
        })
        .join("");
    };
    pintarAuto(leer());
    document.addEventListener("progress:change", (e) => pintarAuto((e as CustomEvent<Progreso>).detail));

    const ta = document.getElementById("codigo-exportar") as HTMLTextAreaElement;
    const refrescar = () => (ta.value = exportar());
    refrescar();
    document.addEventListener("progress:change", refrescar);

    const estadoCopiar = document.getElementById("estado-copiar")!;
    document.getElementById("btn-copiar")!.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(ta.value);
        estadoCopiar.textContent = "Copiado.";
      } catch {
        ta.select();
        estadoCopiar.textContent = "Selecciona el texto y cópialo con Ctrl+C.";
      }
      setTimeout(() => (estadoCopiar.textContent = ""), 3000);
    });

    const tin = document.getElementById("codigo-importar") as HTMLTextAreaElement;
    const estadoImportar = document.getElementById("estado-importar")!;
    document.getElementById("btn-importar")!.addEventListener("click", () => {
      const p = importar(tin.value);
      if (p) {
        estadoImportar.textContent = `Restaurado: ${p.completadas.length} lecciones completadas.`;
        tin.value = "";
      } else {
        estadoImportar.textContent = "Código no válido.";
      }
    });

    document.getElementById("btn-reiniciar")!.addEventListener("click", () => {
      if (confirm("¿Borrar todo el progreso guardado en este navegador?")) reiniciar();
    });
  </script>
</Curso>

<style>
  .tarjeta {
    max-width: 72ch;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    margin-bottom: 24px;
  }
  .tarjeta h2 {
    font-size: 17px;
    margin-bottom: 6px;
  }
  .tarjeta p {
    font-size: 14.5px;
    color: var(--muted);
  }
  .tarjeta p strong {
    color: var(--text);
  }
  .barra-global {
    height: 8px;
    border-radius: 8px;
    background: var(--line-strong);
    overflow: hidden;
    margin-bottom: 14px;
  }
  .barra-global .fill,
  .mini .fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gold);
    transition: width 0.4s;
  }
  .nota {
    font-size: 14px;
  }

  .modulos {
    max-width: 72ch;
    margin-bottom: 24px;
  }
  .mod {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 10px;
  }
  .mod summary {
    list-style: none;
    display: grid;
    grid-template-columns: 36px 1fr auto 90px;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    cursor: pointer;
  }
  .mod summary::-webkit-details-marker {
    display: none;
  }
  .mod .idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold);
  }
  .mod .nombre {
    font-weight: 500;
    font-size: 15px;
  }
  .mod .cuenta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .mini {
    display: block;
    height: 4px;
    border-radius: 4px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .mod ol {
    list-style: none;
    border-top: 1px solid var(--line);
    padding: 8px 10px 10px;
  }
  .mod li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .fila {
    flex: 1;
    display: grid;
    grid-template-columns: 16px 30px 1fr;
    gap: 10px;
    align-items: center;
    text-align: left;
    padding: 8px 8px;
    border-radius: 8px;
    font-size: 14.5px;
    color: var(--muted);
    transition: background 0.2s, color 0.2s;
  }
  .fila:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .fila.hecha {
    color: var(--text);
  }
  .fila .marca {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
  }
  .fila .marca.hecha {
    border-color: var(--ok);
    background: var(--ok);
  }
  .fila .n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold);
  }
  .fila .t :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .ir {
    font-family: var(--font-mono);
    color: var(--muted-2);
    padding: 6px 10px;
    border-radius: 6px;
  }
  .ir:hover {
    color: var(--gold);
    background: var(--surface-2);
  }

  .auto-lista {
    list-style: none;
    margin-top: 12px;
  }
  .auto-lista li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 14px;
    align-items: baseline;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .auto-lista li:last-child {
    border-bottom: 0;
  }
  .al-score {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--gold);
  }
  .al-fecha {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-2);
  }
  .dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 14px;
  }
  .codigo {
    width: 100%;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text);
    background: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 10px 12px;
    resize: vertical;
    word-break: break-all;
  }
  .codigo:focus {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .acciones {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .estado {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ok);
  }
  .peligro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-color: var(--err-soft);
  }
  .peligro .btn:hover {
    color: var(--err);
    border-color: var(--err);
  }
  @media (max-width: 640px) {
    .dos {
      grid-template-columns: 1fr;
    }
    .mod summary {
      grid-template-columns: 36px 1fr auto;
    }
    .mini {
      display: none;
    }
  }
</style>
